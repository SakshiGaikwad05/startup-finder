# Required. Matches docker-compose.yml (run `npm run db:up` first).
# You can point this at any PostgreSQL instead.
DATABASE_URL=postgresql://startup:startup@localhost:5433/startup_finder

# Optional. Brave Search API key (https://brave.com/search/api/).
# When set, the "search" source runs profile-based queries and follows
# public ATS job-board links (Greenhouse / Lever / Ashby). Leave empty to skip.
SEARCH_API_KEY=
